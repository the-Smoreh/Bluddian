# Bluddian configuration.
#
# Copy to .env.local and fill in, or just run `npm run keygen` which generates
# the secrets for you. NEVER commit .env.local — it's already in .gitignore.

# ---------------------------------------------------------------- required --

# 32 random bytes, base64-encoded. Encrypts every third-party API key you store
# (AES-256-GCM). Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing this value makes previously stored API keys permanently unreadable.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------- optional --

# Required to complete first-run setup. Set this if the app is reachable from
# the internet, so nobody can claim the dashboard before you do. Remove the
# line once your account exists.
SETUP_CODE=

# Where SQLite writes. Defaults to ./data/bluddian.db
DATABASE_PATH=./data/bluddian.db

# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
# Leaving this unset when you ARE behind a proxy means all traffic shares one
# rate-limit bucket. Setting it when you are NOT behind one lets a client forge
# the header and bypass rate limiting entirely.
TRUST_PROXY=

# Allow non-Secure cookies. Only for local HTTP development.
INSECURE_COOKIES=

# ------------------------------------------------------------ integrations --
#
# These are optional: you can add the same values through the Settings screen,
# where they're encrypted at rest. Values set here take priority over the UI,
# which is what you want on a hosting platform that injects secrets.

# Anthropic — needs an ADMIN key (sk-ant-admin...), which only an org owner can
# create. Console → Settings → Admin keys. Without one, log spend manually.
ANTHROPIC_ADMIN_API_KEY=

# Whop — dashboard → Developer → API keys
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=

# Shopify — custom app with read_orders + read_products
SHOPIFY_SHOP_DOMAIN=yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
